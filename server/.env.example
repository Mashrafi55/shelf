PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/shelf
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Optional
# Set to 1 when running behind a reverse proxy (Render, Nginx, ...) so rate limits use real client IPs
# TRUST_PROXY=1
# Use "none" only if the client and API are on different sites (requires https)
# COOKIE_SAMESITE=lax
# Max size of the on-disk book text cache in MB (default 500)
# CACHE_MAX_MB=500

# Email (verification + password reset). If SMTP_HOST is empty, emails are printed to the server console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Shelf <no-reply@yourdomain.com>
